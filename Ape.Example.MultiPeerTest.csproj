<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Ape.Example.MultiPeerTest</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Ape.Core\Ape.Core.csproj" />
    <ProjectReference Include="Services\Ape.Module.MultiPeerTest.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Config\author\author.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Config\joiner\joiner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests/**" />
    <Compile Remove="Services/**" />
    <Compile Remove="SceneEntities/**" />
    <Compile Remove="Common/**" />
    <None Remove="Tests/**" />
    <None Remove="Services/**" />
    <None Remove="SceneEntities/**" />
    <None Remove="Common/**" />
  </ItemGroup>

</Project>
