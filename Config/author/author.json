{
  "modules": {
    "Ape.Core.Logging": {
      "enabled": true,
      "level": "info",
      "transport": "console"
    },
    "Ape.Core.Network": {
      "enabled": true,
      "transport": "quic",
      "role": "peer",
      "peerName": "author",
      "port": 0,
      "keepAliveSeconds": 15,
      "reconnect": { "initialSeconds": 1, "maxSeconds": 8 }
    },
    "Ape.Module.DiscoveryManager": {
      "connect": { "enabled": true },
      "ssdp": { "vpnUnicastProbe": { "enabled": false } }
    },
    "Ape.Core.Scene": {
      "logCommits": true
    },
    "Ape.Module.MultiPeerTest": {
      "author": true,
      "intervalMilliseconds": 5000
    }
  }
}
